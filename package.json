{
  "name": "fiber-poker",
  "version": "0.1.0",
  "private": true,
  "description": "Single-table 2-6 player No-Limit Texas Hold'em settled over Nervos Fiber Network channels. Devnet/testnet only.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:engine": "vitest run packages/poker-engine tests/engine",
    "test:protocol": "vitest run packages/protocol tests/protocol",
    "test:server": "vitest run tests/integration tests/chaos",
    "demo:two": "tsx tests/integration/demos/two-player-demo.ts",
    "demo:six": "tsx tests/integration/demos/six-player-demo.ts",
    "server": "tsx apps/table-server/src/main.ts",
    "agent": "npm run agent -w @fiber-poker/player-agent"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "fast-check": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "ws": "^8.18.0"
  }
}